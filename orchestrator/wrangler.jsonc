{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quarterly-ascension",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-28",
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    "ASSET_CODE": "DLBR",
    "ASSET_ISSUER": "GBJQKX4HMW3X2SLAXBCNOYNSAXYKYAHBXYAKGV4ZJZTEA6OPU5ZWGSG4",
    "ASSET_SAC": "CDJA3FKDCWFVWJ544X2AZRFO54IZ6RALRAVDDCA5IIWY4EERZQD23XZD",
    "STELLAR_NETWORK": "testnet",
    "HORIZON_URL": "https://horizon-testnet.stellar.org",
    // Hosted on SDF's Ecosystem Cloudflare account. The two URLs below embed
    // that account's ID + AI Gateway slug + Workers subdomain. None of those
    // are credentials — the gateway rejects requests without CF_AIG_TOKEN.
    "OPENAI_BASE_URL": "https://gateway.ai.cloudflare.com/v1/ba55b7ae9acfb3ed152103e3497c0752/quarterly-ascension/compat",
    // The gateway pays OpenAI from the account's credits (Unified Billing):
    // no OpenAI key exists anywhere. Secrets: CF_AIG_TOKEN (gateway auth).
    "AIG_UNIFIED_BILLING": "true",
    // The Ecosystem account is shared, so every NPC worker is prefixed.
    "NPC_BASE_URL": "https://quarterly-ascension-__npc__.sdf-ecosystem.workers.dev",
    "TICK_INTERVAL_MS": "480000",
    "MAX_TICKS": "60",
    "LOBBY_DURATION_MS": "1800000",

    // Phase 5: NPC reward source addresses (public keys are non-sensitive; the
    // matching SECRETs are pushed via `wrangler secret put`).
    "HR_DEPT_ADDRESS": "GD334TP3L7FCSHHG6EJYSUCUWHDV3QLO36Y2MA4JUABAMYC3PZ4ZPHA4",
    "MOTIVATIONAL_SPEAKER_ADDRESS": "GDH3L6HTC47MR5JXMN6F7RFBWI4IH7ZYZRNC4AQNPVYV5ASZXNMC7BBZ"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quarterly-ascension",
      "database_id": "87eec2f7-3ad5-4e9b-816e-030a60e99067",
      "migrations_dir": "../db/migrations"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "ORCHESTRATOR",
        "class_name": "GameOrchestrator"
      }
    ]
  },

  // Email is switched off for now: no binding means the game neither
  // collects nor sends email. To switch it back on, restore this block
  // (sender domain must be onboarded on the same account) and the email
  // field on the claim form in display/public/agent.html.
  // "send_email": [
  //   { "name": "EMAIL" }
  // ],

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameOrchestrator"]
    }
  ],

  "observability": {
    "enabled": true
  }
}
